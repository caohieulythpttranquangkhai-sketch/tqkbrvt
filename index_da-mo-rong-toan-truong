      { id: 2, name: "Nguyễn Văn Bảo", gender: "Nam", group: "Tổ 2", role: "Bí thư", code: `PH${CLASS_NAME}-8ABX-77K2-LL1A`, score: 100, history: [] },
      { id: 3, name: "Trần Quốc Cường", gender: "Nam", group: "Tổ 3", role: "Tổ trưởng", code: `PH${CLASS_NAME}-33QA-55PP-88ZZ`, score: 90, history: [{ date: "2026-09-09", reason: "Quên mang vở bài tập Vật lí", type: "minus", points: 10, week: 1 }] },
      { id: 4, name: "Lê Thị Thùy Dung", gender: "Nữ", group: "Tổ 4", role: "Thủ quỹ", code: `PH${CLASS_NAME}-77CC-99KK-22VV`, score: 100, history: [] }
    ];
    let currentStudentId = students.length > 0 ? students[0].id : null;

    // 2. DỮ LIỆU TKB
    const defaultTkb = {
      note: "Áp dụng: Năm học 2026 - 2027",
      grid: [
        ["Chào cờ", "Toán", "Vật lí", "Hóa học", "Ngữ văn", "Lịch sử"],
        ["Sinh hoạt", "Toán", "Vật lí", "Hóa học", "Ngữ văn", "Địa lí"],
        ["Toán", "Tiếng Anh", "Hóa học", "Ngữ văn", "Tin học", "GDCD"],
        ["Vật lí", "Tiếng Anh", "Sinh học", "Toán", "Thể dục", "Công nghệ"],
        ["Vật lí", "Tin học", "Sinh học", "Toán", "Thể dục", "Tự học"]
      ],
      afternoonGrid: [
        ["Tăng cường Toán", "Bồi dưỡng Vật lí", "Tăng cường Hóa", "Tăng cường Anh", "Tự chọn KHTN", "Nghỉ"],
        ["Tăng cường Toán", "Bồi dưỡng Vật lí", "Tăng cường Hóa", "Tăng cường Anh", "Tự chọn KHTN", "Nghỉ"],
        ["Luyện đề TN", "Luyện đề TN", "GDQP - AN", "Luyện đề TN", "SH Câu lạc bộ", "Nghỉ"],
        ["Thể thao / CLB", "Thể thao / CLB", "GDQP - AN", "Thể thao / CLB", "SH Câu lạc bộ", "Nghỉ"]
      ]
    };
    let tkbData = JSON.parse(localStorage.getItem(`class_tkb_full_${CLASS_CODE}`)) || defaultTkb;

    // 3. SỔ BÁO BÀI 40 TUẦN
    function init40WeeksBaoBai() {
      const obj = {};
      for (let w = 1; w <= TOTAL_WEEKS; w++) {
        obj[w] = {
          t2_m: "Ôn tập kiến thức tuần cũ, chuẩn bị bài mới", t2_a: "Luyện giải bài tập chuyên đề",
          t3_m: "Làm bài tập SBT theo yêu cầu", t3_a: "Thực hành bài tập nâng cao",
          t4_m: "Chuẩn bị bài học trên lớp", t4_a: "Kiểm tra 15 phút chuyên đề",
