      return obj;
    }
    let baobaiData = JSON.parse(localStorage.getItem(`class_baobai_full_${CLASS_CODE}`)) || init40WeeksBaoBai();
    let currentBaoBaiWeek = 1;

    // 4. THI ĐUA 40 TUẦN
    function init40WeeksWeeklyData() {
      const data = {};
