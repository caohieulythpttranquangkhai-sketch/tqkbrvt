    function saveAttendance(e) {
      e.preventDefault();
      const editId = document.getElementById('attEditId').value;
      const targetWeek = parseInt(document.getElementById('attModalWeekSelect').value);
      const studentId = parseInt(document.getElementById('attStudentSelect').value);
      const std = students.find(s => s.id === studentId);
      if (!std) return;

      const date = document.getElementById('attDate').value;
      const status = document.getElementById('attStatus').value;
      const note = document.getElementById('attNote').value.trim();

      if (editId) {
        const idx = attendanceData.findIndex(r => r.id === parseInt(editId));
        if (idx !== -1) {
          attendanceData[idx] = {
            id: parseInt(editId),
            week: targetWeek,
            studentId: std.id,
            name: std.name,
            group: std.group,
            date: date,
            status: status,
            note: note
          };
        }
      } else {
        attendanceData.unshift({
          id: Date.now(),
          week: targetWeek,
          studentId: std.id,
          name: std.name,
          group: std.group,
          date: date,
          status: status,
          note: note
