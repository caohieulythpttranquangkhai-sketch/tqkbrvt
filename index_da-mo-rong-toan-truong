    function renderAttendanceView() {
      const semester = currentAttendanceWeek <= 20 ? "HK1" : "HK2";
      document.getElementById('attendanceWeekBadge').innerText = `CHUYÊN CẦN 40 TUẦN • TUẦN ${currentAttendanceWeek} - ${semester}`;
      document.getElementById('attWeekTableTitle').innerText = `Tuần ${currentAttendanceWeek}`;

      const tbody = document.getElementById('attendanceTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      const weekRecords = attendanceData.filter(item => parseInt(item.week) === currentAttendanceWeek);
      document.getElementById('attTotalRecordsBadge').innerText = `${weekRecords.length} lượt ghi nhận`;

      let countExcused = 0, countUnexcused = 0, countLate = 0;
      weekRecords.forEach(item => {
        if (item.status === 'Có phép') countExcused++;
        else if (item.status === 'Không phép') countUnexcused++;
        else if (item.status === 'Đi muộn') countLate++;
      });

      document.getElementById('attStatExcused').innerText = countExcused;
      document.getElementById('attStatUnexcused').innerText = countUnexcused;
      document.getElementById('attStatLate').innerText = countLate;

      const totalStudents = students.length || 1;
      const totalAbsences = countExcused + countUnexcused;
      let presentRate = 100 - Math.min(100, ((totalAbsences / (totalStudents * 6)) * 100));
      if (isNaN(presentRate)) presentRate = 100;
      document.getElementById('attStatPresent').innerText = `${presentRate.toFixed(1)}%`;

      if (weekRecords.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="text-center py-8 text-slate-400 font-medium">
              <i class="fa-solid fa-circle-check text-emerald-500 text-xl block mb-2"></i>
              Tuần ${currentAttendanceWeek} chưa có học sinh vắng hoặc đi muộn. Sĩ số lớp ${CLASS_NAME} đạt 100%!
            </td>
          </tr>
        `;
        applyPermissions();
        return;
      }

      weekRecords.forEach(item => {
        let badge = 'bg-amber-100 text-amber-800';
        if (item.status === 'Không phép') badge = 'bg-rose-100 text-rose-800 font-bold';
        if (item.status === 'Đi muộn') badge = 'bg-blue-100 text-blue-800';

        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 border-b";
        tr.innerHTML = `
          <td class="py-3 px-4 font-mono text-xs text-slate-500">${item.date}</td>
          <td class="py-3 px-4 font-bold text-slate-800">${item.name}</td>
          <td class="py-3 px-3 text-center"><span class="bg-slate-100 text-slate-700 text-xs px-2 py-0.5 rounded">${item.group}</span></td>
          <td class="py-3 px-4 text-center"><span class="${badge} text-xs px-2.5 py-1 rounded-full">${item.status}</span></td>
          <td class="py-3 px-6 text-slate-600">${item.note || '--'}</td>
          <td class="py-3 px-4 text-center">
            <div class="flex items-center justify-center gap-1.5">
              <button onclick="openEditAttendanceModal(${item.id})" class="text-emerald-700 hover:text-emerald-900 p-1.5 rounded hover:bg-emerald-50 transition" title="Sửa"><i class="fa-solid fa-pen-to-square"></i></button>
              <button onclick="deleteAttendanceRecord(${item.id})" class="text-rose-500 hover:text-rose-700 p-1.5 rounded hover:bg-rose-50 transition" title="Xóa"><i class="fa-regular fa-trash-can"></i></button>
