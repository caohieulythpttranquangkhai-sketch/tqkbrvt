    function processBulkImport() {
      const text = document.getElementById('bulkNamesInput').value.trim();
      if (!text) { alert("Vui lòng dán danh sách học sinh vào ô!"); return; }
      const lines = text.split('\n');
      let count = 0;
      const groups = ["Tổ 1", "Tổ 2", "Tổ 3", "Tổ 4"];
      lines.forEach((line, idx) => {
        let name = line.trim().replace(/^[\d]+[\.\)]?\s*/, '').trim();
        if (name) {
          students.push({
            id: Date.now() + idx, name: name, gender: "Nam", group: groups[idx % 4],
            role: "Thành viên", code: generateParentCode(), score: 50, history: []
          });
          count++;
        }
      });
      renderTable(); closeImportModal(); alert(`Đã thêm thành công ${count} học sinh!`);
      syncToCloud(); // FIX: đây là nguyên nhân chính - nhập danh sách lớp trước đây không hề lên cloud
    }

