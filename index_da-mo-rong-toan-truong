    function saveViolationRecord(e) {
      e.preventDefault();
      const mode = document.getElementById('violationEditMode').value;
      const targetWeek = parseInt(document.getElementById('violationModalWeekSelect').value);
      const studentId = parseInt(document.getElementById('violationStudentSelect').value);
      const std = students.find(s => s.id === studentId);
      if (!std) return;

      const date = document.getElementById('violationDate').value;
      const points = parseInt(document.getElementById('violationPoints').value) || 5;
      const reason = document.getElementById('violationReason').value.trim();

      if (mode === 'add') {
        const newRecord = {
          id: Date.now(),
          week: targetWeek,
          studentId: std.id,
          name: std.name,
          group: std.group,
          date: date,
          reason: reason,
          points: points
        };
        violations40wData.unshift(newRecord);

        if (!std.history) std.history = [];
        std.history.unshift({ date: date, reason: reason, type: "minus", points: points, week: targetWeek, vId: newRecord.id });
      } else {
        const recordId = parseInt(document.getElementById('violationRecordId').value);
        const idx = violations40wData.findIndex(r => r.id === recordId);
        if (idx !== -1) {
          violations40wData[idx] = {
            id: recordId,
            week: targetWeek,
            studentId: std.id,
            name: std.name,
            group: std.group,
            date: date,
            reason: reason,
            points: points
          };

          if (std.history) {
            const hIdx = std.history.findIndex(h => h.vId === recordId);
            if (hIdx !== -1) {
              std.history[hIdx] = { date: date, reason: reason, type: "minus", points: points, week: targetWeek, vId: recordId };
            }
          }
        }
      }

      localStorage.setItem(`class_violations_40w_${CLASS_CODE}`, JSON.stringify(violations40wData));
      localStorage.setItem(`class_students_${CLASS_CODE}`, JSON.stringify(students));
      syncToCloud();
      currentViolationWeek = targetWeek;
      renderViolationWeekDropdown();
      renderViolationsView();
      renderRenLuyenModule();
      closeViolationModal();
    }

    function deleteViolationRecord(recordId) {
      const record = violations40wData.find(r => r.id === recordId);
      if (record && confirm(`Thầy có chắc muốn xóa lỗi vi phạm "${record.reason}" của học sinh "${record.name}"?`)) {
        violations40wData = violations40wData.filter(r => r.id !== recordId);
        
        const std = students.find(s => s.id === record.studentId);
        if (std && std.history) {
          std.history = std.history.filter(h => h.vId !== recordId && !(h.date === record.date && h.reason === record.reason));
        }

        localStorage.setItem(`class_violations_40w_${CLASS_CODE}`, JSON.stringify(violations40wData));
        localStorage.setItem(`class_students_${CLASS_CODE}`, JSON.stringify(students));
        syncToCloud();
        renderViolationsView();
        renderRenLuyenModule();
      }
    }

    function deleteViolationWeekData() {
      if (confirm(`Thầy có chắc chắn muốn xóa toàn bộ vi phạm của Tuần ${currentViolationWeek}?`)) {
        const recordsToDelete = violations40wData.filter(r => parseInt(r.week) === currentViolationWeek);
        recordsToDelete.forEach(rec => {
          const std = students.find(s => s.id === rec.studentId);
