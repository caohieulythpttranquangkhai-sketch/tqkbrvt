    // XUẤT EXCEL
    // Xuất sơ đồ chỗ ngồi ra file Excel (.xls) để in, giữ đúng bố cục 4 dãy x 6 bàn
    // Xuất bảng điểm hạnh kiểm toàn lớp theo tuần: mỗi học kỳ bắt đầu từ 50 điểm,
    // trừ theo từng lần vi phạm (hoặc cộng theo khen thưởng), sang học kỳ 2 tính lại từ đầu.
    function getConductRank_(score) {
      if (score >= 40) return "Tốt";
      if (score >= 25) return "Khá";
      if (score >= 10) return "Đạt";
      return "Chưa Đạt";
    }

    function exportConductReportToExcel() {
      if (!students || students.length === 0) {
        alert("Chưa có học sinh nào trong danh sách lớp để xuất báo cáo!");
        return;
      }

      const semesters = [
        { label: "HỌC KỲ 1 (Tuần 1 - 20)", weekStart: 1, weekEnd: 20 },
        { label: "HỌC KỲ 2 (Tuần 21 - 40)", weekStart: 21, weekEnd: 40 }
      ];

      let htmlContent = `
        <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
        <head>
          <meta charset="UTF-8">
          <style>
            table { border-collapse: collapse; width: 100%; font-family: 'Times New Roman', Times, serif; margin-bottom: 24px; }
            th { background-color: #0b3d2c; color: #ffffff; font-weight: bold; border: 1px solid #000000; padding: 6px; text-align: center; font-size: 12px; }
            td { border: 1px solid #000000; padding: 6px; text-align: center; vertical-align: middle; font-size: 12px; }
            .name-col { text-align: left; font-weight: bold; }
            .plus { color: #059669; font-weight: bold; }
            .minus { color: #dc2626; font-weight: bold; }
            h2 { text-align: center; }
            h3 { margin-top: 20px; background-color: #f1f5f9; padding: 6px; }
          </style>
        </head>
        <body>
          <h2>BẢNG TỔNG HỢP ĐIỂM HẠNH KIỂM LỚP ${CLASS_NAME} (THEO TUẦN)</h2>
      `;

      semesters.forEach(sem => {
        htmlContent += `<h3>${sem.label} - Mỗi học sinh bắt đầu từ 50 điểm, tính lại từ đầu khi sang học kỳ mới</h3>`;
        htmlContent += `<table><tr><th>STT</th><th>Họ và Tên</th><th>Tổ</th>`;
        for (let w = sem.weekStart; w <= sem.weekEnd; w++) {
          htmlContent += `<th>Tuần ${w}</th>`;
        }
        htmlContent += `<th>Tổng Cộng/Trừ</th><th>Điểm Hạnh Kiểm</th><th>Xếp Loại</th></tr>`;

        students.forEach((std, idx) => {
          let score = 50;
          const weekCells = [];
          for (let w = sem.weekStart; w <= sem.weekEnd; w++) {
            // Bản ghi cũ (tạo trước khi có cột "Tuần") không có h.week -> quy ước tính vào Tuần 1 để không bị mất dữ liệu
            const weekItems = (std.history || []).filter(h => (parseInt(h.week) || 1) === w);
            let weekNet = 0;
            weekItems.forEach(h => {
              weekNet += (h.type === 'plus' ? (h.points || 0) : -(h.points || 0));
            });
            score += weekNet;
            weekCells.push(weekNet);
          }

          const totalChange = score - 50;
          htmlContent += `<tr><td>${idx + 1}</td><td class="name-col">${escapeHtml(std.name)}</td><td>${escapeHtml(std.group)}</td>`;
          weekCells.forEach(v => {
            if (v > 0) htmlContent += `<td class="plus">+${v}</td>`;
            else if (v < 0) htmlContent += `<td class="minus">${v}</td>`;
            else htmlContent += `<td></td>`;
          });
          htmlContent += `<td class="${totalChange > 0 ? 'plus' : (totalChange < 0 ? 'minus' : '')}">${totalChange > 0 ? '+' + totalChange : totalChange}</td>`;
          htmlContent += `<td><b>${score}</b></td><td>${getConductRank_(score)}</td></tr>`;
        });

        htmlContent += `</table>`;
      });

      htmlContent += `</body></html>`;

      const blob = new Blob(['\ufeff' + htmlContent], { type: 'application/vnd.ms-excel;charset=utf-8;' });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `BangDiemHanhKiem_CaLop_${CLASS_NAME}.xls`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function exportSeatingToExcel() {
      const rowsConfig = [
        { label: "DÃY 1 (Cửa sổ)", key: "row1" },
        { label: "DÃY 2 (Giữa trái)", key: "row2" },
        { label: "DÃY 3 (Giữa phải)", key: "row3" },
        { label: "DÃY 4 (Cửa chính)", key: "row4" }
      ];

      let htmlContent = `
        <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
        <head>
          <meta charset="UTF-8">
          <style>
            table { border-collapse: collapse; width: 100%; font-family: 'Times New Roman', Times, serif; }
            th { background-color: #0b3d2c; color: #ffffff; font-weight: bold; border: 1px solid #000000; padding: 8px; text-align: center; }
            td { border: 1px solid #000000; padding: 10px; text-align: center; vertical-align: middle; font-size: 13px; }
            .board { background-color: #e2e8f0; font-weight: bold; text-align: center; padding: 8px; border: 1px solid #000000; }
            .desk-label { background-color: #f1f5f9; font-weight: bold; }
          </style>
        </head>
        <body>
          <h2 style="text-align:center;">SƠ ĐỒ VỊ TRÍ CHỖ NGỒI LỚP ${CLASS_NAME}</h2>
          <table>
            <tr>
      `;
      rowsConfig.forEach(r => { htmlContent += `<th colspan="2">${r.label}</th>`; });
      htmlContent += `</tr>`;

      for (let deskIdx = 0; deskIdx < 6; deskIdx++) {
        // Dòng 1: tên 2 học sinh nằm cạnh nhau, mỗi người 1 cột riêng
        htmlContent += `<tr>`;
        rowsConfig.forEach(r => {
          const desks = seatingData[r.key] || [];
          const desk = desks[deskIdx] || ["Trống", "Trống"];
          const s1 = escapeHtml(desk[0] || "Trống");
          const s2 = escapeHtml(desk[1] || "Trống");
          htmlContent += `<td>${s1}</td><td>${s2}</td>`;
        });
        htmlContent += `</tr>`;

        // Dòng 2: nhãn "Bàn X" gộp ngang 2 cột, nằm SAU dữ liệu học sinh (áp dụng đồng nhất cho mọi bàn)
        htmlContent += `<tr>`;
        rowsConfig.forEach(() => {
          htmlContent += `<td class="desk-label" colspan="2">Bàn ${6 - deskIdx}</td>`;
        });
        htmlContent += `</tr>`;
      }

      const totalCols = rowsConfig.length * 2; // 8 cột (4 dãy x 2 chỗ)
      htmlContent += `<tr><td style="border:none;" colspan="2"></td><td class="board" colspan="4">BẢNG TỪ</td><td class="board" style="background-color:#d1fae5;" colspan="2">BÀN GIÁO VIÊN</td></tr>`;
      htmlContent += `<tr><td colspan="${totalCols}" style="text-align:left; border:none; font-weight:bold; padding-top:10px;">🚪 Cửa ra vào</td></tr>`;

      htmlContent += `</table></body></html>`;

      const blob = new Blob(['\ufeff' + htmlContent], { type: 'application/vnd.ms-excel;charset=utf-8;' });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `SoDo_ChoNgoi_${CLASS_NAME}.xls`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function exportViolationsToExcel(mode) {
      let filteredRecords = [];
      let fileName = "";

      if (mode === 'week') {
        filteredRecords = violations40wData.filter(item => parseInt(item.week) === currentViolationWeek);
        fileName = `ViPham_Tuan_${currentViolationWeek}_${CLASS_NAME}.xls`;
      } else if (mode === 'hk1') {
        filteredRecords = violations40wData.filter(item => parseInt(item.week) >= 1 && parseInt(item.week) <= 20);
        fileName = `ViPham_HocKy_1_${CLASS_NAME}.xls`;
      } else if (mode === 'hk2') {
        filteredRecords = violations40wData.filter(item => parseInt(item.week) >= 21 && parseInt(item.week) <= 40);
        fileName = `ViPham_HocKy_2_${CLASS_NAME}.xls`;
      }

      if (filteredRecords.length === 0) {
        alert(`Không có dữ liệu vi phạm nào để xuất cho lựa chọn này!`);
        return;
      }

      let htmlContent = `
        <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
        <head>
          <meta charset="UTF-8">
          <style>
            table { border-collapse: collapse; width: 100%; font-family: 'Times New Roman', Times, serif; }
            th { background-color: #0b3d2c; color: #ffffff; font-weight: bold; border: 1px solid #000000; padding: 8px; text-align: center; }
            td { border: 1px solid #000000; padding: 6px; vertical-align: middle; }
            .text-center { text-align: center; }
            .text-right { text-align: right; }
          </style>
        </head>
        <body>
          <h2>BẢNG TỔNG HỢP VI PHẠM RÈN LUYỆN LỚP ${CLASS_NAME}</h2>
          <table>
            <thead>
              <tr>
                <th>STT</th>
                <th>Tuần</th>
                <th>Thời gian</th>
                <th>Học sinh</th>
                <th>Tổ</th>
                <th>Hành vi vi phạm</th>
                <th>Điểm trừ</th>
              </tr>
            </thead>
            <tbody>
      `;

      filteredRecords.forEach((item, index) => {
        htmlContent += `
          <tr>
            <td class="text-center">${index + 1}</td>
            <td class="text-center">Tuần ${item.week}</td>
            <td class="text-center">${item.date}</td>
            <td><b>${item.name}</b></td>
            <td class="text-center">${item.group}</td>
            <td>${item.reason || ""}</td>
            <td class="text-center" style="color: red; font-weight: bold;">-${item.points}đ</td>
          </tr>
        `;
      });

      htmlContent += `
            </tbody>
          </table>
        </body>
        </html>
      `;

      const blob = new Blob(['\ufeff' + htmlContent], { type: 'application/vnd.ms-excel;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      
      link.setAttribute("href", url);
      link.setAttribute("download", fileName);
      document.body.appendChild(link);
      link.click();
      link.remove();
      
      alert(`✅ Đã xuất thành công file Excel có sẵn kẻ khung (${fileName})!`);
    }

    // Xuất danh sách điểm danh/chuyên cần (học sinh nghỉ có phép, không phép, đi muộn)
    // theo Tuần đang chọn, hoặc theo cả Học Kỳ 1 (Tuần 1-20) / Học Kỳ 2 (Tuần 21-40).
    function exportAttendanceToExcel(mode) {
      let filteredRecords = [];
      let fileName = "";
      let rangeLabel = "";

      if (mode === 'week') {
        filteredRecords = attendanceData.filter(item => parseInt(item.week) === currentAttendanceWeek);
        fileName = `ChuyenCan_Tuan_${currentAttendanceWeek}_${CLASS_NAME}.xls`;
        rangeLabel = `TUẦN ${currentAttendanceWeek}`;
      } else if (mode === 'hk1') {
        filteredRecords = attendanceData.filter(item => parseInt(item.week) >= 1 && parseInt(item.week) <= 20);
        fileName = `ChuyenCan_HocKy_1_${CLASS_NAME}.xls`;
        rangeLabel = `HỌC KỲ 1 (TUẦN 1 - 20)`;
      } else if (mode === 'hk2') {
        filteredRecords = attendanceData.filter(item => parseInt(item.week) >= 21 && parseInt(item.week) <= 40);
        fileName = `ChuyenCan_HocKy_2_${CLASS_NAME}.xls`;
        rangeLabel = `HỌC KỲ 2 (TUẦN 21 - 40)`;
      }

      if (filteredRecords.length === 0) {
        alert(`Không có dữ liệu chuyên cần nào để xuất cho lựa chọn này!`);
        return;
      }

      // Sắp xếp theo tuần tăng dần để dễ theo dõi khi xuất cả học kỳ
      filteredRecords = filteredRecords.slice().sort((a, b) => parseInt(a.week) - parseInt(b.week));

      let countExcused = 0, countUnexcused = 0, countLate = 0;
      filteredRecords.forEach(item => {
        if (item.status === 'Có phép') countExcused++;
        else if (item.status === 'Không phép') countUnexcused++;
        else if (item.status === 'Đi muộn') countLate++;
      });

      let htmlContent = `
        <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
        <head>
          <meta charset="UTF-8">
          <style>
            table { border-collapse: collapse; width: 100%; font-family: 'Times New Roman', Times, serif; }
            th { background-color: #0b3d2c; color: #ffffff; font-weight: bold; border: 1px solid #000000; padding: 8px; text-align: center; }
            td { border: 1px solid #000000; padding: 6px; vertical-align: middle; }
            .text-center { text-align: center; }
            .excused { color: #b45309; font-weight: bold; }
            .unexcused { color: #dc2626; font-weight: bold; }
            .late { color: #1d4ed8; font-weight: bold; }
          </style>
        </head>
        <body>
          <h2>BẢNG TỔNG HỢP ĐIỂM DANH & CHUYÊN CẦN LỚP ${CLASS_NAME}</h2>
          <h3 style="text-align:center; margin-top:-8px;">${rangeLabel}</h3>
          <p>Tổng số lượt: <b>${filteredRecords.length}</b> &nbsp;|&nbsp; Vắng có phép (P): <b>${countExcused}</b> &nbsp;|&nbsp; Vắng không phép (KP): <b>${countUnexcused}</b> &nbsp;|&nbsp; Đi muộn (M): <b>${countLate}</b></p>
          <table>
            <thead>
              <tr>
                <th>STT</th>
                <th>Tuần</th>
                <th>Ngày</th>
                <th>Học sinh</th>
                <th>Tổ</th>
                <th>Trạng thái</th>
                <th>Lý do / Ghi chú</th>
              </tr>
            </thead>
            <tbody>
      `;

      filteredRecords.forEach((item, index) => {
        let statusClass = 'excused';
        if (item.status === 'Không phép') statusClass = 'unexcused';
        else if (item.status === 'Đi muộn') statusClass = 'late';

        htmlContent += `
          <tr>
            <td class="text-center">${index + 1}</td>
            <td class="text-center">Tuần ${item.week}</td>
            <td class="text-center">${item.date}</td>
            <td><b>${escapeHtml(item.name)}</b></td>
            <td class="text-center">${escapeHtml(item.group)}</td>
            <td class="text-center ${statusClass}">${item.status}</td>
            <td>${escapeHtml(item.note || "")}</td>
          </tr>
        `;
      });

      htmlContent += `
            </tbody>
          </table>
        </body>
        </html>
      `;

      const blob = new Blob(['\ufeff' + htmlContent], { type: 'application/vnd.ms-excel;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.setAttribute("href", url);
      link.setAttribute("download", fileName);
      document.body.appendChild(link);
      link.click();
      link.remove();

      alert(`✅ Đã xuất thành công file Excel chuyên cần (${fileName})!`);
    }


    // ================= KHỞI TẠO HỆ THỐNG (DUY NHẤT 1 LUỒNG, KHÔNG CÒN TRÙNG LẶP) =================
    // Trước đây có 2 đoạn DOMContentLoaded khác nhau cùng tự fetch dữ liệu độc lập,
    // chạy song song và có thể ghi đè lẫn nhau. Giờ gộp lại 1 luồng duy nhất,
    // dùng chung hàm loadDataFromCloud() ở trên để nhất quán logic (có so sánh timestamp).
    window.addEventListener('DOMContentLoaded', async () => {
      // 0. Đổi mọi nhãn "12A1" tĩnh trong giao diện thành tên lớp thật đang đăng nhập
      applyClassBranding();

      // 1. Vẽ giao diện ngay với dữ liệu đang có sẵn trong localStorage (hiển thị tức thì, không chờ mạng)
      if (typeof renderWeekDropdown === 'function') renderWeekDropdown();
      if (typeof renderWeeklyView === 'function') renderWeeklyView();
      if (typeof renderTable === 'function') renderTable();
      if (typeof renderDutyWeekDropdown === 'function') renderDutyWeekDropdown();
      if (typeof renderAttendanceWeekDropdown === 'function') renderAttendanceWeekDropdown();
      if (typeof renderViolationWeekDropdown === 'function') renderViolationWeekDropdown();
      if (typeof applyPermissions === 'function') applyPermissions();

      // 2. Sau đó kéo bản mới nhất từ cloud về (nếu có mạng) và vẽ lại nếu có gì mới hơn
      await loadDataFromCloud(true);

      // 3. Từ giờ trở đi, tự động kiểm tra định kỳ (đã thiết lập ở setInterval phía trên)
    });
  </script>
</body>
