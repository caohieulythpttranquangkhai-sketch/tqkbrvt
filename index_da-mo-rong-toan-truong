// ================= HỆ THỐNG ĐỒNG BỘ TOÀN DIỆN (TỰ ĐỘNG TẤT CẢ CÁC MỤC) =================
// Đã viết lại để khắc phục:
//  - Không còn 2 luồng tải dữ liệu song song gây ghi đè lẫn nhau (race condition)
//  - Thêm mốc thời gian (timestamp) để biết bản trên cloud mới hơn hay cũ hơn bản đang xem
//  - Không tự động ghi đè dữ liệu khi người dùng đang mở form nhập liệu (modal)
//  - Không dùng "no-cors" một cách mù quáng nữa -> biết chính xác lưu thành công hay lỗi
//  - Tự động làm mới định kỳ để 2 thiết bị nhìn thấy dữ liệu mới của nhau mà không cần F5

const SYNC_TS_KEY = `class_last_sync_ts_${CLASS_CODE}`;
const SYNC_KEYS_PREFIX_CHECK = (key) =>
  key.startsWith('class_') || key.includes(CLASS_CODE) || key.includes('student') || key.includes('violation') || key.includes('attendance');

let isSyncing = false;

function setSyncStatus(mode) {
  const statusEl = document.getElementById('syncStatus');
  if (!statusEl) return;
  const modes = {
    syncing: `<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> Đang đồng bộ...`,
    ok:      `<span class="w-2 h-2 rounded-full bg-emerald-400"></span> Đã lưu trực tuyến`,
    loaded:  `<span class="w-2 h-2 rounded-full bg-emerald-400"></span> Đã cập nhật mới nhất`,
    local:   `<span class="w-2 h-2 rounded-full bg-slate-400"></span> Chỉ lưu cục bộ (chưa lên được cloud)`,
    error:   `<span class="w-2 h-2 rounded-full bg-rose-500"></span> Lỗi đồng bộ`
  };
  statusEl.innerHTML = modes[mode] || modes.local;
}

// Có modal nào đang mở không? Nếu có thì KHÔNG tự động ghi đè dữ liệu đang gõ dở của người dùng
function isAnyModalOpen() {
  return Array.from(document.querySelectorAll('[id$="Modal"]'))
    .some(el => el.classList.contains('flex') && !el.classList.contains('hidden'));
}

// 1. HÀM GỬI: Tự động quét và đóng gói TẤT CẢ dữ liệu của lớp gửi lên Cloud
async function syncToCloud() {
  if (!CLOUD_ENABLED) { setSyncStatus('local'); return false; }

  setSyncStatus('syncing');

  try {
    const fullData = {};
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (SYNC_KEYS_PREFIX_CHECK(key)) {
        try {
          fullData[key] = JSON.parse(localStorage.getItem(key));
        } catch (e) {
          fullData[key] = localStorage.getItem(key);
        }
      }
    }

    // Gắn mốc thời gian để thiết bị khác biết đây là bản mới nhất
    const nowTs = Date.now();

    const res = await fetch(GOOGLE_SHEET_API_URL, {
      method: "POST",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: JSON.stringify({
        action: "syncAll",
        secretToken: SYNC_SECRET_TOKEN,
        classCode: CLASS_CODE,   // để máy chủ lưu riêng dữ liệu của từng lớp, không đè lẫn nhau
        className: CLASS_NAME,
        updatedAt: nowTs,
        fullData: fullData
      })
    });

    // Nếu Apps Script trả về lỗi HTTP thật sự thì coi là thất bại, không "ảo tưởng" thành công
    if (!res.ok) throw new Error("HTTP " + res.status);

    localStorage.setItem(SYNC_TS_KEY, String(nowTs));
    setSyncStatus('ok');
    return true;
  } catch (e) {
    console.warn("Đồng bộ lên cloud thất bại, dữ liệu tạm thời chỉ lưu trên máy này:", e);
    setSyncStatus('local');
    return false;
  }
}

// 2. HÀM TẢI: Kéo dữ liệu từ Cloud về, CHỈ áp dụng nếu bản trên cloud mới hơn bản đang có
//    force = true (bấm nút "Làm mới" thủ công) sẽ luôn tải và áp dụng, kể cả khi timestamp bằng nhau.
async function loadDataFromCloud(force = false) {
  if (!CLOUD_ENABLED) { setSyncStatus('local'); return; }
  if (isSyncing) return; // tránh gọi chồng chéo nhiều lần cùng lúc
  if (!force && isAnyModalOpen()) return; // đừng ghi đè dữ liệu khi người dùng đang nhập liệu dở

  isSyncing = true;
  if (force) setSyncStatus('syncing');

  try {
    const res = await fetch(GOOGLE_SHEET_API_URL + "?t=" + Date.now() + "&classCode=" + encodeURIComponent(CLASS_CODE));
    if (!res.ok) throw new Error("HTTP " + res.status);
    const json = await res.json();

    if (json.status === "success" && json.data && Object.keys(json.data).length > 0) {
      const cloudTs = parseInt(json.data.updatedAt || json.updatedAt || 0) || 0;
      const localTs = parseInt(localStorage.getItem(SYNC_TS_KEY) || 0) || 0;

      // Nếu không phải làm mới thủ công, chỉ áp dụng khi cloud thực sự mới hơn
      if (!force && cloudTs > 0 && cloudTs <= localTs) {
        setSyncStatus('loaded');
        return;
      }

      Object.keys(json.data).forEach(key => {
        if (key === 'updatedAt') return;
        const val = typeof json.data[key] === 'object' ? JSON.stringify(json.data[key]) : json.data[key];
        localStorage.setItem(key, val);
      });
      if (cloudTs > 0) localStorage.setItem(SYNC_TS_KEY, String(cloudTs));

      if (localStorage.getItem(`class_students_${CLASS_CODE}`)) {
        students = JSON.parse(localStorage.getItem(`class_students_${CLASS_CODE}`));
      }
      if (localStorage.getItem(`class_violations_40w_${CLASS_CODE}`)) {
        violations40wData = JSON.parse(localStorage.getItem(`class_violations_40w_${CLASS_CODE}`));
      }
      if (typeof attendanceData !== 'undefined' && localStorage.getItem(`class_attendance_40w_${CLASS_CODE}`)) {
        attendanceData = JSON.parse(localStorage.getItem(`class_attendance_40w_${CLASS_CODE}`));
      }
      if (typeof weeklyData !== 'undefined' && localStorage.getItem(`class_weekly_40w_full_${CLASS_CODE}`)) {
        weeklyData = JSON.parse(localStorage.getItem(`class_weekly_40w_full_${CLASS_CODE}`));
        // Dọn lại các tuần vẫn còn Hạng #1 mặc định cũ từ trang tính về trạng thái để trống.
        // Nếu có thay đổi, đẩy ngược bản đã dọn lên lại trang tính để lần tải sau không bị đè lại.
        if (typeof migrateDefaultRanksToBlank === 'function' && migrateDefaultRanksToBlank(weeklyData)) {
          localStorage.setItem(`class_weekly_40w_full_${CLASS_CODE}`, JSON.stringify(weeklyData));
          setTimeout(() => { if (typeof syncToCloud === 'function') syncToCloud(); }, 500);
        }
      }
      if (typeof duty40WeeksData !== 'undefined' && localStorage.getItem(`class_duty_40w_${CLASS_CODE}`)) {
        duty40WeeksData = JSON.parse(localStorage.getItem(`class_duty_40w_${CLASS_CODE}`));
      }
      if (typeof baobaiData !== 'undefined' && localStorage.getItem(`class_baobai_full_${CLASS_CODE}`)) {
        baobaiData = JSON.parse(localStorage.getItem(`class_baobai_full_${CLASS_CODE}`));
      }
      if (typeof fundData !== 'undefined' && localStorage.getItem(`class_fund_${CLASS_CODE}`)) {
        fundData = JSON.parse(localStorage.getItem(`class_fund_${CLASS_CODE}`));
      }
      if (localStorage.getItem(`class_criteria_student_${CLASS_CODE}`) !== null) {
        criteriaStudentText = localStorage.getItem(`class_criteria_student_${CLASS_CODE}`);
      }
      if (localStorage.getItem(`class_criteria_school_${CLASS_CODE}`) !== null) {
        criteriaSchoolText = localStorage.getItem(`class_criteria_school_${CLASS_CODE}`);
      }
      criteriaStudentPdf = loadCriteriaPdf(`class_criteria_student_pdf_${CLASS_CODE}`);
      criteriaSchoolPdf = loadCriteriaPdf(`class_criteria_school_pdf_${CLASS_CODE}`);
      if (typeof renderCriteria === 'function') renderCriteria();

      // Vẽ lại toàn bộ giao diện với dữ liệu mới
      if (typeof renderTable === 'function') renderTable();
      if (typeof renderViolationsView === 'function') renderViolationsView();
      if (typeof renderRenLuyenModule === 'function') renderRenLuyenModule();
      if (typeof renderDiemDanh === 'function') renderDiemDanh();
      if (typeof renderChuyenCan === 'function') renderChuyenCan();
      if (typeof renderWeekDropdown === 'function') renderWeekDropdown();
      if (typeof renderWeeklyView === 'function') renderWeeklyView();
      if (typeof renderDutyWeekDropdown === 'function') renderDutyWeekDropdown();
      if (typeof renderAttendanceWeekDropdown === 'function') renderAttendanceWeekDropdown();
      if (typeof renderViolationWeekDropdown === 'function') renderViolationWeekDropdown();

      setSyncStatus('loaded');
    } else {
      setSyncStatus('local');
    }
  } catch (err) {
    console.warn("Không tải được dữ liệu từ máy chủ:", err);
    setSyncStatus('error');
  } finally {
    isSyncing = false;
  }
}

