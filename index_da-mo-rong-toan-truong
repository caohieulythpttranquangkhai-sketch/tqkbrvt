        data[w] = {
          semester: w <= 20 ? "Học Kỳ 1" : "Học Kỳ 2",
          rankBlock: "", rankSchool: "", score: 100.0, title: "Cờ Luân Lưu", scoreNote: "0 vi phạm",
          notes: [
            `Tuần ${w}: Toàn thể ${CLASS_NAME} có mặt trước 06:40 truy bài.`,
            `Tuần ${w}: Đồng phục đúng quy định, sơ mi trắng và bảng tên.`,
            `Tuần ${w}: Giữ vững 100% tiết học xếp loại Tốt.`
