        violations40wData = violations40wData.filter(r => parseInt(r.week) !== currentViolationWeek);
        localStorage.setItem(`class_violations_40w_${CLASS_CODE}`, JSON.stringify(violations40wData));
        localStorage.setItem(`class_students_${CLASS_CODE}`, JSON.stringify(students));
        syncToCloud(); // FIX: trước đây thiếu dòng này nên xoá cả tuần không lên cloud
        renderViolationsView();
        renderRenLuyenModule();
      }
    }

