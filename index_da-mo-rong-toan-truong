  <script>
    const TOTAL_WEEKS = 40;
// --- CẤU HÌNH ĐÁM MÂY ---
    // ⚠️ DÁN URL Apps Script (.../exec) sau khi Deploy vào đây. Để trống nghĩa là chưa kết nối cloud.
    const GOOGLE_SHEET_API_URL = "https://script.google.com/macros/s/AKfycbzuEdo9xezE2pMU0vdsYcn6snWZJx_WJMEjKg1eUC2OU6ZNXgLhBJN6tJzSFDjRi4JZAw/exec";
    // Lưu ý bảo mật: token này CHỈ mang tính giảm thiểu, không phải bảo mật tuyệt đối,
