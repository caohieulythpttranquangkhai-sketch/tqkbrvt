    // (doPost) phải tự kiểm tra token này trước khi cho phép ghi/đọc dữ liệu.
    // Token này ĐÃ khớp sẵn với file GoogleAppsScript_Backend.gs mới - không cần đổi gì thêm.
    const SYNC_SECRET_TOKEN = "C12A1-yhxeqy6UB6EO9H6hycY8";

    const CLOUD_ENABLED = GOOGLE_SHEET_API_URL && !GOOGLE_SHEET_API_URL.startsWith("DÁN_URL");

    // --- CẤU HÌNH LỚP HỌC (bản dùng chung cho toàn trường) ---
    // File này giờ dùng chung cho MỌI lớp trong trường. Ở lần mở đầu tiên trên mỗi máy/trình
    // duyệt, GVCN chọn mã lớp mình phụ trách; từ đó toàn bộ khóa lưu dữ liệu cục bộ, mã học
    // sinh, và dữ liệu gửi lên máy chủ dùng chung đều được gắn kèm mã lớp này để không lẫn
    // dữ liệu giữa các lớp. Đổi lớp: xoá 2 mục 'active_class_code' / 'active_class_name'
    // trong localStorage (hoặc dùng nút "Đổi lớp" ở mục Cài đặt) rồi tải lại trang.
    function initClassIdentity() {
      let code = localStorage.getItem('active_class_code');
      let name = localStorage.getItem('active_class_name');
      if (code && name) return { code, name };

      let raw = null;
      while (!raw) {
        raw = window.prompt("Chào Thầy/Cô! Vui lòng nhập mã LỚP đang phụ trách (VD: 12A1, 11A3, 10A5):", "12A1");
        if (raw === null) { raw = "12A1"; break; }
        raw = raw.trim();
      }
      name = raw.toUpperCase().replace(/[^A-Z0-9]/g, "");
      if (!name) name = "12A1";
      code = name.toLowerCase();
      localStorage.setItem('active_class_code', code);
      localStorage.setItem('active_class_name', name);
      return { code, name };
    }
    const __classIdentity = initClassIdentity();
    const CLASS_CODE = __classIdentity.code;   // vd: "12a1" — dùng làm hậu tố khoá localStorage & tham số gửi server
    const CLASS_NAME = __classIdentity.name;   // vd: "12A1" — dùng để hiển thị trên giao diện

    // Tự động thay mọi chữ "12A1" còn cứng trong HTML tĩnh (tiêu đề, sidebar, tên các mục...)
    // bằng tên lớp thật (CLASS_NAME) ngay khi trang vừa tải xong, để không phải sửa tay từng dòng HTML.
    function applyClassBranding() {
      document.title = document.title.replace(/12A1/g, CLASS_NAME);
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null);
      const nodesToFix = [];
      let node;
      while ((node = walker.nextNode())) {
        if (node.nodeValue.includes('12A1')) nodesToFix.push(node);
      }
      nodesToFix.forEach(n => { n.nodeValue = n.nodeValue.replace(/12A1/g, CLASS_NAME); });
    }

    // Chuyển sang quản lý một lớp khác trên cùng máy này (dữ liệu từng lớp lưu tách biệt,
    // không mất dữ liệu của lớp cũ — chỉ đổi "lớp đang xem").
    function switchClass() {
      const raw = window.prompt("Nhập mã LỚP muốn chuyển sang quản lý (VD: 11A3):", CLASS_NAME);
      if (!raw) return;
      const name = raw.trim().toUpperCase().replace(/[^A-Z0-9]/g, "");
      if (!name) return;
      localStorage.setItem('active_class_code', name.toLowerCase());
      localStorage.setItem('active_class_name', name);
      window.location.reload();
    }

    // Chống XSS: luôn escape dữ liệu do người dùng nhập trước khi chèn vào innerHTML
    function escapeHtml(str) {
      if (str === null || str === undefined) return "";
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }
