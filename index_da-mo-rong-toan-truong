<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hệ Thống Quản Lý Lớp Học - 12A1 - THPT Trần Quang Khải-BRVT</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    body { font-family: 'Inter', sans-serif; background-color: #f4f6f8; }
    .bg-custom-dark { background-color: #0b3d2c; }
    .bg-custom-header { background-color: #0f4c36; }
    .text-custom-yellow { color: #facc15; }
    .tab-btn-active {
      background-color: #0b3d2c !important;
      color: #ffffff !important;
      font-weight: 600;
    }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col md:flex-row">

  <!-- 1. THANH ĐIỀU HƯỚNG DỌC -->
  <aside class="w-full md:w-64 bg-[#0b3d2c] text-white flex-shrink-0 flex flex-col justify-between shadow-xl z-30 min-h-screen">
    <div>
      <!-- Header thương hiệu lớp học -->
      <div class="p-5 border-b border-emerald-800/60 bg-[#082e21]">
        <div class="flex items-center space-x-3">
          <div class="w-11 h-11 rounded-xl bg-emerald-700/70 border border-emerald-500 flex items-center justify-center text-emerald-300 text-xl shadow-inner flex-shrink-0">
            <i class="fa-solid fa-graduation-cap"></i>
          </div>
          <div class="overflow-hidden">
            <div class="flex items-center space-x-1.5">
              <span class="font-extrabold text-xl tracking-tight text-white">12A1</span>
              <span class="text-[10px] bg-amber-400 text-slate-900 px-1.5 py-0.5 rounded font-bold">2026-2027</span>
            </div>
            <p class="text-[11px] text-emerald-200/80 truncate mt-0.5">THPT Trần Quang Khải - BRVT</p>
          </div>
        </div>
        <div class="mt-3 pt-3 border-t border-emerald-800/50 flex items-center justify-between text-xs text-emerald-200">
          <span class="flex items-center gap-1.5 text-emerald-400 font-medium text-[11px]">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Trực tuyến
          </span>
          <span class="text-[11px] font-medium text-amber-300"></span>
        </div>
      </div>

      <!-- Danh sách menu chức năng bố trí dọc -->
      <nav class="p-3 space-y-1.5 text-xs font-medium">
        <button id="nav-thuhang" onclick="switchTab('thuhang')" class="tab-btn tab-btn-active w-full px-3.5 py-3 rounded-xl flex items-center gap-3 transition text-left">
          <i class="fa-solid fa-ranking-star w-4 text-center"></i> Thứ hạng trường & khối
        </button>
        <button id="nav-vipham" onclick="switchTab('vipham')" class="tab-btn w-full px-3.5 py-3 rounded-xl text-emerald-100/80 hover:bg-emerald-800/50 hover:text-white flex items-center gap-3 transition text-left">
          <i class="fa-solid fa-triangle-exclamation w-4 text-center text-amber-400"></i> Vi phạm rèn luyện
        </button>
        <button id="nav-hoctap" onclick="switchTab('hoctap')" class="tab-btn w-full px-3.5 py-3 rounded-xl text-emerald-100/80 hover:bg-emerald-800/50 hover:text-white flex items-center gap-3 transition text-left">
          <i class="fa-solid fa-book-open w-4 text-center"></i> Theo dõi học tập
        </button>
        <button id="nav-baobai" onclick="switchTab('baobai')" class="tab-btn w-full px-3.5 py-3 rounded-xl text-emerald-100/80 hover:bg-emerald-800/50 hover:text-white flex items-center gap-3 transition text-left">
          <i class="fa-regular fa-calendar-check w-4 text-center"></i> Báo bài & TKB
        </button>
        <button id="nav-trucnhat" onclick="switchTab('trucnhat')" class="tab-btn w-full px-3.5 py-3 rounded-xl text-emerald-100/80 hover:bg-emerald-800/50 hover:text-white flex items-center gap-3 transition text-left">
          <i class="fa-solid fa-wand-magic-sparkles w-4 text-center"></i> Lịch trực nhật
        </button>
        <button id="nav-renluyen" onclick="switchTab('renluyen')" class="tab-btn w-full px-3.5 py-3 rounded-xl text-emerald-100/80 hover:bg-emerald-800/50 hover:text-white flex items-center gap-3 transition text-left">
          <i class="fa-solid fa-users w-4 text-center"></i> Rèn luyện cá nhân
        </button>
        <button id="nav-chuyencan" onclick="switchTab('chuyencan')" class="tab-btn w-full px-3.5 py-3 rounded-xl text-emerald-100/80 hover:bg-emerald-800/50 hover:text-white flex items-center gap-3 transition text-left">
          <i class="fa-solid fa-clipboard-user w-4 text-center"></i> Điểm danh & Chuyên cần
        </button>
        <button id="nav-sodo" onclick="switchTab('sodo')" class="tab-btn w-full px-3.5 py-3 rounded-xl text-emerald-100/80 hover:bg-emerald-800/50 hover:text-white flex items-center gap-3 transition text-left">
          <i class="fa-solid fa-border-all w-4 text-center"></i> Sơ đồ lớp (4x6)
        </button>
        <button id="nav-quylop" onclick="switchTab('quylop')" class="tab-btn w-full px-3.5 py-3 rounded-xl text-emerald-100/80 hover:bg-emerald-800/50 hover:text-white flex items-center gap-3 transition text-left">
          <i class="fa-solid fa-wallet w-4 text-center"></i> Quản lý Quỹ lớp
        </button>
        <div class="pt-3 border-t border-emerald-800/50">
          <button id="nav-caidat" onclick="switchTab('caidat')" class="tab-btn w-full px-3.5 py-3 rounded-xl bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold flex items-center gap-3 shadow-md transition text-left">
            <i class="fa-solid fa-gear w-4 text-center"></i> Cài đặt danh sách lớp
          </button>
        </div>
      </nav>
    </div>

    <!-- Chân sidebar -->
    <div class="p-4 border-t border-emerald-800/50 bg-[#082e21] text-[11px] text-emerald-200/70 text-center">
      <p>GVCN: Hoàng Cao Hiếu</p>
      <p class="text-[10px] text-emerald-400 mt-0.5">Niên khóa 2026 – 2027</p>
    </div>
  </aside>

  <!-- KHUNG NỘI DUNG CHÍNH -->
  <div class="flex-1 flex flex-col min-h-screen overflow-y-auto">

    <!-- Header nhỏ đầu trang -->
    <header class="bg-white border-b border-slate-200 px-6 py-3.5 flex flex-wrap justify-between items-center gap-4 shadow-xs sticky top-0 z-20">
      <div class="flex items-center space-x-2">
        <span class="text-xs bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-lg font-bold border border-emerald-200">
          HỆ THỐNG QUẢN LÝ LỚP HỌC
        </span>
        <span class="text-xs text-slate-500 italic hidden sm:inline">“Mỗi tuần một bước tiến – Cùng nhau bứt phá 12A1”</span>
      </div>
      <div class="flex items-center space-x-3 text-xs">
        <span class="font-semibold text-slate-700 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200">
          <i class="fa-regular fa-calendar mr-1.5 text-amber-500"></i> Năm học 2026 - 2027
        </span>
        <span class="font-bold text-emerald-800 bg-emerald-50 px-3 py-1.5 rounded-lg border border-emerald-200">
          <i class="fa-solid fa-user-tie mr-1 text-emerald-600"></i> GVCN: Thầy Hoàng Cao Hiếu
        </span>
        <span id="syncStatus" class="font-semibold text-slate-500 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-slate-400"></span> Chưa đồng bộ
        </span>
        <button id="manualRefreshBtn" onclick="loadDataFromCloud(true)" title="Tải lại dữ liệu mới nhất từ máy chủ" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition shadow-sm cursor-pointer border border-slate-200">
          <i class="fa-solid fa-rotate"></i> Làm mới
        </button>
        <button id="adminStatusBtn" onclick="toggleAdminAccess()" class="bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold text-xs px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition shadow-sm cursor-pointer">
          <i class="fa-solid fa-lock"></i> Đăng nhập GVCN
        </button>
      </div>
    </header>

    <!-- TAB 1: THỨ HẠNG TRƯỜNG & KHỐI -->
    <section id="section-thuhang" class="tab-content flex flex-1 flex-col p-6 space-y-6">
      <div class="bg-custom-header rounded-2xl p-6 text-white shadow-md relative overflow-hidden flex flex-wrap justify-between items-center gap-4">
        <div>
          <span id="displayWeekBadge" class="inline-block bg-amber-400 text-slate-900 text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-2">
            THI ĐUA KHỐI 12 • TUẦN 1 - HỌC KỲ 1
          </span>
          <h1 class="text-2xl font-bold flex items-center gap-2.5 text-white">
            <i class="fa-solid fa-trophy text-custom-yellow"></i> Bảng Xếp Hạng Thi Đua Khối 12 - THPT Trần Quang Khải
          </h1>
          <p class="text-emerald-100/80 text-sm mt-1">
            Theo dõi, cập nhật kết quả thi đua và ghi nhận chỉ đạo 40 tuần của GVCN Hoàng Cao Hiếu.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <select id="selectWeek" onchange="onWeekChange()" class="bg-[#0b3d2c] text-white font-semibold text-xs px-3.5 py-2.5 rounded-xl border border-emerald-600/70 focus:outline-none focus:ring-2 focus:ring-amber-400"></select>
          <button onclick="openWeeklyModal()" class="bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold text-xs px-4 py-2.5 rounded-xl transition shadow-sm flex items-center gap-1.5">
            <i class="fa-solid fa-pen-to-square"></i> Cập Nhật / Sửa
          </button>
          <button onclick="deleteWeeklyData()" class="w-9 h-9 rounded-xl bg-rose-600 hover:bg-rose-700 text-white flex items-center justify-center transition shadow-sm" title="Đặt lại dữ liệu tuần này">
            <i class="fa-solid fa-trash-can text-sm"></i>
          </button>
        </div>
      </div>

      <!-- 4 Card KPI -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs text-slate-500 font-medium">Hạng Trong Khối 12</p>
            <h3 class="text-2xl font-bold text-slate-800 mt-1" id="kpiRankBlock">Chưa cập nhật</h3>
            <p class="text-[11px] text-slate-400 font-medium mt-1" id="kpiRankBlockDesc">Thầy sẽ cập nhật hàng tuần</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl font-bold">
            <i class="fa-solid fa-crown"></i>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs text-slate-500 font-medium">Hạng Toàn Trường THPT</p>
            <h3 class="text-2xl font-bold text-slate-800 mt-1" id="kpiRankSchool">Chưa cập nhật</h3>
            <p class="text-[11px] text-slate-400 mt-1">Toàn trường</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl font-bold">
            <i class="fa-solid fa-school"></i>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs text-slate-500 font-medium">Tổng Điểm Đoàn Trường</p>
            <h3 class="text-2xl font-bold text-emerald-700 mt-1" id="kpiScore">100 <span class="text-xs font-normal text-slate-400">/ 100đ</span></h3>
            <p class="text-[11px] text-emerald-600 font-medium mt-1" id="kpiScoreNote">0 vi phạm</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-xl">
            <i class="fa-solid fa-chart-line"></i>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs text-slate-500 font-medium">Danh Hiệu Tuần</p>
            <h3 class="text-xl font-bold text-amber-600 mt-1" id="kpiTitle">Cờ Luân Lưu</h3>
            <p class="text-[11px] text-emerald-600 font-semibold mt-1">Đoàn trường khen thưởng</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-flag"></i>
          </div>
        </div>
      </div>

      <!-- Dặn dò của GVCN & Đánh giá phong độ -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
          <div class="flex justify-between items-center border-b pb-2">
            <h2 class="font-bold text-slate-800 text-base flex items-center gap-2">
              <i class="fa-solid fa-bullhorn text-amber-500"></i> Dặn Dò Trọng Tâm GVCN
            </h2>
            <button onclick="openWeeklyModal()" class="text-xs text-emerald-700 hover:text-emerald-900 font-semibold flex items-center gap-1">
              <i class="fa-solid fa-pen"></i> Sửa
            </button>
          </div>
          <div class="space-y-3 text-xs" id="gvcnNotesContainer"></div>
        </div>

        <div class="lg:col-span-2 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div class="flex justify-between items-center mb-4 border-b pb-2">
            <h2 class="font-bold text-slate-800 text-base flex items-center gap-2">
              <i class="fa-solid fa-chart-column text-emerald-700"></i> Đánh Giá Phong Độ & Tiến Độ <span id="historyWeekTitle" class="text-emerald-800 font-bold">Tuần 1</span>
            </h2>
            <span class="text-xs bg-slate-100 text-slate-600 px-3 py-1 rounded-full font-medium">THPT Trần Quang Khải</span>
          </div>

          <div class="w-full space-y-4 text-xs py-2" id="historyBarsContainer"></div>

          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Chủ nhiệm lớp: <strong>Thầy Hoàng Cao Hiếu</strong></span>
            <span>Mục tiêu tuần kế tiếp: <strong class="text-emerald-700">100.0 Điểm Tuyệt Đối</strong></span>
          </div>
        </div>
      </div>

      <!-- Điểm Thi Đua 4 Tổ -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
        <div class="flex justify-between items-center mb-4 border-b pb-2">
          <h2 class="font-bold text-slate-800 text-base flex items-center gap-2">
            <i class="fa-solid fa-medal text-custom-yellow"></i> Điểm Thi Đua Nội Bộ 4 Tổ (Tuần Đang Chọn)
            <span class="text-[10px] font-semibold bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full border border-emerald-200">Tự động từ Vi Phạm &amp; Điểm Cộng</span>
          </h2>
          <button onclick="openWeeklyModal()" class="text-xs bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-semibold px-3 py-1.5 rounded-lg border border-emerald-200 flex items-center gap-1.5 transition">
            <i class="fa-solid fa-pen-to-square"></i> Cập nhật điểm 4 tổ
          </button>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm" id="groupCardsContainer"></div>
      </div>

      <!-- So Sánh Thứ Hạng & Thành Tích Theo Từng Học Kỳ (độc lập HK1 / HK2) -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
        <div class="flex justify-between items-center mb-4 border-b pb-2">
          <h2 class="font-bold text-slate-800 text-base flex items-center gap-2">
            <i class="fa-solid fa-scale-balanced text-custom-yellow"></i> Tổng Kết Thứ Hạng Theo Học Kỳ
          </h2>
          <span class="text-xs bg-slate-100 text-slate-600 px-3 py-1 rounded-full font-medium">HK1: Tuần 1-20 • HK2: Tuần 21-40 (tính độc lập)</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="semesterSummaryContainer"></div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-6" id="semesterWeeklyTablesContainer"></div>
      </div>

      <!-- Tiêu Chuẩn Thi Đua Học Sinh & Đoàn Trường (GVCN nhập tay) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col">
          <div class="flex justify-between items-center mb-4 border-b pb-2">
            <h2 class="font-bold text-slate-800 text-base flex items-center gap-2">
              <i class="fa-solid fa-user-graduate text-custom-yellow"></i> Tiêu Chuẩn Thi Đua Của Học Sinh
            </h2>
            <button onclick="openCriteriaModal('student')" class="text-xs bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-semibold px-3 py-1.5 rounded-lg border border-emerald-200 flex items-center gap-1.5 transition">
              <i class="fa-solid fa-pen-to-square"></i> Sửa
            </button>
          </div>
          <div id="criteriaStudentContainer" class="text-xs text-slate-700 leading-relaxed whitespace-pre-wrap flex-1"></div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col">
          <div class="flex justify-between items-center mb-4 border-b pb-2">
            <h2 class="font-bold text-slate-800 text-base flex items-center gap-2">
              <i class="fa-solid fa-school-flag text-custom-yellow"></i> Tiêu Chuẩn Thi Đua Của Đoàn Trường
            </h2>
            <button onclick="openCriteriaModal('school')" class="text-xs bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-semibold px-3 py-1.5 rounded-lg border border-emerald-200 flex items-center gap-1.5 transition">
              <i class="fa-solid fa-pen-to-square"></i> Sửa
            </button>
          </div>
          <div id="criteriaSchoolContainer" class="text-xs text-slate-700 leading-relaxed whitespace-pre-wrap flex-1"></div>
        </div>
      </div>
    </section>

    <!-- MODAL: Tiêu Chuẩn Thi Đua (Học Sinh / Đoàn Trường) -->
    <div id="criteriaModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
      <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
        <h3 class="font-bold mb-1" id="criteriaModalTitle">Sửa Tiêu Chuẩn Thi Đua</h3>
        <p class="text-xs text-slate-500 mb-4">Thầy gõ tay HOẶC tải lên 1 file PDF tiêu chuẩn thi đua (có thể dùng cả 2). Nội dung/PDF sẽ hiển thị trên trang.</p>
        <form onsubmit="saveCriteria(event)" class="space-y-4 text-sm">
          <input type="hidden" id="criteriaType" />

          <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2">
            <label class="block text-xs font-semibold text-slate-700">Tải lên file PDF (tối đa ~5MB)</label>
            <input type="file" id="criteriaPdfInput" accept="application/pdf" onchange="handleCriteriaPdfSelect(event)" class="text-xs w-full" />
            <div id="criteriaPdfCurrentInfo" class="text-xs text-slate-600"></div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Hoặc nhập nội dung dạng văn bản</label>
            <textarea id="criteriaTextarea" rows="10" class="w-full px-3 py-2 border rounded-lg text-xs leading-relaxed" placeholder="Ví dụ:&#10;1. Đi học đúng giờ, nghỉ học phải có phép...&#10;2. Đồng phục đúng quy định...&#10;3. ..."></textarea>
          </div>

          <div class="flex justify-end gap-2 pt-3 border-t">
            <button type="button" onclick="closeCriteriaModal()" class="px-4 py-2 bg-slate-100 text-xs rounded-lg">Hủy</button>
            <button type="submit" class="px-4 py-2 bg-emerald-700 text-white text-xs font-semibold rounded-lg">Lưu</button>
          </div>
        </form>
      </div>
    </div>

    <!-- TAB 2: VI PHẠM RÈN LUYỆN -->
    <section id="section-vipham" class="tab-content hidden flex-1 flex-col p-6 space-y-6">
      <div class="bg-custom-header rounded-2xl p-6 text-white shadow-md flex flex-wrap justify-between items-center gap-4">
        <div>
          <span id="violationWeekBadge" class="inline-block bg-amber-400 text-slate-900 text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-2">
            VI PHẠM 40 TUẦN • TUẦN 1 - HK1
          </span>
          <h1 class="text-2xl font-bold flex items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation text-custom-yellow"></i> Sổ Tổng Hợp Vi Phạm Rèn Luyện 12A1 (40 Tuần)
          </h1>
          <p class="text-xs text-emerald-100 mt-1">Ghi nhận chi tiết các vi phạm theo 40 tuần học, phân loại theo tổ và tự động đồng bộ hồ sơ rèn luyện cá nhân</p>
