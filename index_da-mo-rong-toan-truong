    let pendingCriteriaPdf = { student: undefined, school: undefined }; // undefined = không đổi, null = xóa, {name,dataUrl} = file mới chọn

    function renderCriteria() {
      function buildBlock(text, pdf, type) {
        let html = '';
        if (pdf && pdf.dataUrl) {
          html += `
            <div class="mb-3">
              <div class="flex items-center justify-between gap-2 mb-2">
