    // Chuyển "Tổ 1".."Tổ 4" (hoặc bất kỳ chuỗi có số ở cuối) thành khóa t1..t4 dùng trong groupScores.
    function getGroupKeyFromName(groupName) {
      const m = /([0-9]+)/.exec(groupName || '');
      return m ? ('t' + m[1]) : null;
    }

    // Tính điểm thi đua tự động của 4 tổ cho 1 tuần cụ thể:
    // - Bắt đầu từ 100đ.
    // - Trừ theo từng vi phạm ghi nhận ở Sổ Tổng Hợp Vi Phạm Rèn Luyện (violations40wData) của tuần đó.
    // - Cộng theo từng "Điểm Cộng" (khen thưởng) ghi ở mục Rèn Luyện Cá Nhân của thành viên tổ đó trong tuần đó.
    // - Trừ thêm các "Trừ Điểm" ghi trực tiếp ở Rèn Luyện Cá Nhân mà KHÔNG qua Sổ Vi Phạm (không có vId),
    //   để không bị trừ trùng 2 lần với các vi phạm đã có trong violations40wData.
    function calculateAutoGroupScores(week) {
      const scores = { t1: 100, t2: 100, t3: 100, t4: 100 };

      violations40wData.filter(v => parseInt(v.week) === week).forEach(v => {
        const key = getGroupKeyFromName(v.group);
        if (key && scores[key] !== undefined) scores[key] -= (v.points || 0);
      });

      students.forEach(std => {
        const key = getGroupKeyFromName(std.group);
        if (!key || scores[key] === undefined) return;
        (std.history || []).forEach(h => {
          const wk = parseInt(h.week) || 1;
          if (wk !== week) return;
          if (h.type === 'plus') {
            scores[key] += (h.points || 0);
          } else if (h.type === 'minus' && !h.vId) {
            scores[key] -= (h.points || 0);
          }
        });
      });

      return scores;
    }

