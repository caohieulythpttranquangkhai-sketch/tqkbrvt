      const container = document.getElementById('semesterSummaryContainer');
      if (!container) return;

      function summarize(weekStart, weekEnd, label, colorCls) {
        let scores = [], ranksBlock = [], ranksSchool = [], coLuanLuuCount = 0;
        for (let w = weekStart; w <= weekEnd; w++) {
          const wd = weeklyData[w];
          if (!wd) continue;
          const sc = parseFloat(wd.score);
          if (!isNaN(sc)) scores.push(sc);
          const rb = parseFloat(wd.rankBlock);
          if (!isNaN(rb)) ranksBlock.push(rb);
          const rs = parseFloat(wd.rankSchool);
          if (!isNaN(rs)) ranksSchool.push(rs);
          if (rs >= 1 && rs <= 3) coLuanLuuCount++;
        }
        const avg = arr => arr.length ? (arr.reduce((a, b) => a + b, 0) / arr.length) : null;
        const best = arr => arr.length ? Math.min(...arr) : null;

        let totalPlusCount = 0;
        students.forEach(std => {
          (std.history || []).forEach(h => {
            const wk = parseInt(h.week) || 1;
            if (wk >= weekStart && wk <= weekEnd && h.type === 'plus') totalPlusCount++;
          });
        });

        const avgScore = avg(scores);
        const bestRankBlock = best(ranksBlock);
        const avgRankBlock = avg(ranksBlock);
        const bestRankSchool = best(ranksSchool);
        const avgRankSchool = avg(ranksSchool);

        return `
          <div class="p-4 rounded-2xl border-2 ${colorCls} space-y-2.5">
            <div class="font-bold text-slate-900 text-sm mb-1">${label}</div>
            <div class="flex justify-between text-xs"><span class="text-slate-500">Điểm thi đua trung bình</span><strong class="text-emerald-700">${avgScore !== null ? avgScore.toFixed(1) : '--'} đ</strong></div>
            <div class="flex justify-between text-xs"><span class="text-slate-500">Hạng khối tốt nhất / trung bình</span><strong class="text-slate-800">${bestRankBlock ?? '--'} / ${avgRankBlock !== null ? avgRankBlock.toFixed(1) : '--'}</strong></div>
            <div class="flex justify-between text-xs"><span class="text-slate-500">Hạng trường tốt nhất / trung bình</span><strong class="text-slate-800">${bestRankSchool ?? '--'} / ${avgRankSchool !== null ? avgRankSchool.toFixed(1) : '--'}</strong></div>
            <div class="flex justify-between text-xs border-t pt-2 mt-1"><span class="text-slate-500">Số tuần đạt Cờ Luân Lưu (tự động khi Hạng Trường 1-3)</span><strong class="text-amber-600">${coLuanLuuCount} tuần</strong></div>
            <div class="flex justify-between text-xs"><span class="text-slate-500">Tổng điểm cộng cá nhân (khen thưởng)</span><strong class="text-emerald-600">${totalPlusCount} lượt</strong></div>
          </div>
        `;
      }

      container.innerHTML =
        summarize(1, 20, 'Học Kỳ 1 (Tuần 1 - 20)', 'border-emerald-300 bg-emerald-50/40') +
        summarize(21, 40, 'Học Kỳ 2 (Tuần 21 - 40)', 'border-cyan-300 bg-cyan-50/40');

      function buildWeeklyTable(weekStart, weekEnd, label, headerCls) {
        let rows = '';
        for (let w = weekStart; w <= weekEnd; w++) {
          const wd = weeklyData[w];
          const score = wd && wd.score !== undefined && wd.score !== '' ? wd.score : '--';
          const rSchool = wd && wd.rankSchool !== undefined && wd.rankSchool !== '' && wd.rankSchool !== null
            ? `Hạng: ${wd.rankSchool}` : 'Chưa cập nhật';
          rows += `
            <tr class="border-b border-slate-100 last:border-0 hover:bg-slate-50/70">
              <td class="px-3 py-1.5 text-slate-600 font-medium">Tuần ${w}</td>
              <td class="px-3 py-1.5 text-right text-emerald-700 font-semibold">${score}${score !== '--' ? 'đ' : ''}</td>
              <td class="px-3 py-1.5 text-right ${rSchool === 'Chưa cập nhật' ? 'text-slate-400 italic' : 'text-slate-800 font-semibold'}">${rSchool}</td>
            </tr>`;
        }
        return `
          <div class="rounded-2xl border border-slate-200 overflow-hidden">
            <div class="px-4 py-2.5 ${headerCls} font-bold text-sm text-white">${label}</div>
            <div class="max-h-80 overflow-y-auto">
              <table class="w-full text-xs">
                <thead class="sticky top-0 bg-slate-50 text-slate-500">
                  <tr>
                    <th class="px-3 py-2 text-left font-semibold">Tuần</th>
                    <th class="px-3 py-2 text-right font-semibold">Điểm Thi Đua</th>
                    <th class="px-3 py-2 text-right font-semibold">Hạng Toàn Trường (Đoàn)</th>
                  </tr>
                </thead>
                <tbody>${rows}</tbody>
              </table>
            </div>
          </div>`;
      }

      const tablesContainer = document.getElementById('semesterWeeklyTablesContainer');
      if (tablesContainer) {
        tablesContainer.innerHTML =
          buildWeeklyTable(1, 20, 'Học Kỳ 1 — Tuần 1 đến Tuần 20', 'bg-emerald-700') +
          buildWeeklyTable(21, 40, 'Học Kỳ 2 — Tuần 21 đến Tuần 40', 'bg-cyan-700');
      }
    }

