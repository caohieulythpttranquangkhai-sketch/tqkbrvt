    function renderViolationsView() {
      const semester = currentViolationWeek <= 20 ? "HK1" : "HK2";
      document.getElementById('violationWeekBadge').innerText = `VI PHẠM 40 TUẦN • TUẦN ${currentViolationWeek} - ${semester}`;
      document.getElementById('vWeekTableTitle').innerText = `Tuần ${currentViolationWeek}`;

      const tbody = document.getElementById('allViolationsTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      const weekRecords = violations40wData.filter(item => parseInt(item.week) === currentViolationWeek);
      document.getElementById('vTotalRecordsBadge').innerText = `${weekRecords.length} vi phạm`;
      document.getElementById('vStatCount').innerText = weekRecords.length;

      let totalDeduction = 0;
      const groupCount = { "Tổ 1": 0, "Tổ 2": 0, "Tổ 3": 0, "Tổ 4": 0 };

      weekRecords.forEach(item => {
        totalDeduction += item.points || 0;
        if (groupCount[item.group] !== undefined) groupCount[item.group]++;
      });

      document.getElementById('vStatPoints').innerText = `-${totalDeduction}đ`;

      let maxErrors = 0, worstGroup = "Không có";
      for (const grp in groupCount) {
        if (groupCount[grp] > maxErrors) {
          maxErrors = groupCount[grp];
          worstGroup = `${grp} (${maxErrors} lỗi)`;
        }
      }
      document.getElementById('vStatWorstGroup').innerText = worstGroup;

      const studentViolationMap = {};
      weekRecords.forEach(item => {
        if (!studentViolationMap[item.studentId]) {
          studentViolationMap[item.studentId] = { name: item.name, totalPoints: 0, count: 0 };
        }
        studentViolationMap[item.studentId].totalPoints += item.points || 0;
        studentViolationMap[item.studentId].count += 1;
      });

      let topViolator = "Không có lỗi", maxP = -1;
      for (const id in studentViolationMap) {
        if (studentViolationMap[id].totalPoints > maxP) {
          maxP = studentViolationMap[id].totalPoints;
          topViolator = `${studentViolationMap[id].name} (-${maxP}đ)`;
        }
      }

      const statStatusEl = document.getElementById('vStatStatus');
      statStatusEl.innerText = topViolator;
      statStatusEl.className = "text-base font-bold text-rose-600 mt-1 truncate";

      if (weekRecords.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="text-center py-8 text-slate-400 font-medium">
              <i class="fa-solid fa-circle-check text-emerald-500 text-xl block mb-2"></i>
              Tuần ${currentViolationWeek} chưa có vi phạm nào được ghi nhận. Toàn thể ${CLASS_NAME} thực hiện rất tốt nề nếp!
            </td>
          </tr>
        `;
        applyPermissions();
        return;
      }

      weekRecords.forEach(h => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 border-b";
        tr.innerHTML = `
          <td class="py-3.5 px-6 font-mono text-xs text-slate-500">${escapeHtml(h.date)}</td>
          <td class="py-3.5 px-6 font-bold text-slate-800">${escapeHtml(h.name)}</td>
          <td class="py-3.5 px-4 text-center"><span class="bg-amber-50 text-amber-800 text-xs px-2 py-0.5 rounded border border-amber-200 font-semibold">${escapeHtml(h.group)}</span></td>
          <td class="py-3.5 px-6 text-slate-700">${escapeHtml(h.reason)}</td>
          <td class="py-3.5 px-4 text-center text-rose-600 font-bold">-${escapeHtml(h.points)}đ</td>
          <td class="py-3.5 px-4 text-center">
            <div class="flex items-center justify-center gap-1.5">
              <button onclick="openEditViolationModal(${h.id})" class="text-emerald-700 hover:text-emerald-900 p-1.5 rounded hover:bg-emerald-50 transition" title="Sửa vi phạm"><i class="fa-solid fa-pen-to-square"></i></button>
              <button onclick="deleteViolationRecord(${h.id})" class="text-rose-500 hover:text-rose-700 p-1.5 rounded hover:bg-rose-50 transition" title="Xóa vi phạm"><i class="fa-regular fa-trash-can"></i></button>
