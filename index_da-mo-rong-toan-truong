    // sẽ được đưa về trạng thái "để trống - chưa cập nhật" đúng như mong muốn ban đầu.
    // Hàm này được gọi lại mỗi khi có dữ liệu mới tải về từ trang tính (cloud), vì bản trên
    // trang tính vẫn có thể còn lưu Hạng #1 mặc định cũ và sẽ ghi đè lại nếu không dọn lại.
    function migrateDefaultRanksToBlank(data) {
      let changed = false;
      Object.keys(data).forEach(w => {
        const wd = data[w];
        if (!wd) return;
        const rbIsDefault = (wd.rankBlock === 1 || wd.rankBlock === "1");
        const rsIsDefault = (wd.rankSchool === 1 || wd.rankSchool === "1");
        if (rbIsDefault) { wd.rankBlock = ""; changed = true; }
        if (rsIsDefault) { wd.rankSchool = ""; changed = true; }
      });
      return changed;
    }
    if (migrateDefaultRanksToBlank(weeklyData)) {
      localStorage.setItem(`class_weekly_40w_full_${CLASS_CODE}`, JSON.stringify(weeklyData));
    }
    let selectedWeek = 1;

    // 4b. TIÊU CHUẨN THI ĐUA (GVCN nhập tay hoặc tải PDF - Học Sinh & Đoàn Trường)
    const DEFAULT_CRITERIA_STUDENT = `1. Đi học đầy đủ, đúng giờ; nghỉ học phải có đơn xin phép.
2. Trang phục đúng quy định của nhà trường.
3. Nghiêm túc trong giờ học, không sử dụng điện thoại khi chưa được phép.
4. Giữ gìn vệ sinh chung, bảo vệ cơ sở vật chất lớp học.
